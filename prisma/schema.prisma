generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String
  email     String    @unique
  password  String
  addresses Address[]
  requests  Request[]
}

model Address {
  id       Int     @id @default(autoincrement())
  street   String
  number   String
  comp     String?
  cep      String
  state    String
  city     String
  district String
  user_id  Int
  user     User    @relation(fields: [user_id], references: [id])
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  description String
  price       Float
  quantity    Int?
  image_url   String
  category    String
  created_at  DateTime           @default(now())
  type        ProductType        @default(SIMPLE)
  components  ProductComponent[]
  requests    Request[]
}

model ProductComponent {
  id         Int     @id @default(autoincrement())
  name       String
  quantity   Int?
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
}

model Request {
  id            Int           @id @default(autoincrement())
  quantity      Int
  price         Float
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  user_id       Int
  product_id    Int
  status        RequestStatus @default(pending)
  observation   String?
  delivery_date DateTime
  delivery_time String?
  payment_id    String?
  payments      Payment[]
  product       Product       @relation(fields: [product_id], references: [id])
  user          User          @relation(fields: [user_id], references: [id])
}

model Payment {
  id          Int      @id @default(autoincrement())
  provider    String
  provider_id String
  amount      Float
  status      String
  created_at  DateTime @default(now())
  request_id  Int
  request     Request  @relation(fields: [request_id], references: [id])
}

enum ProductType {
  SIMPLE
  CUSTOM
}

enum RequestStatus {
  pending
  paid
  canceled
  processing
  delivered
}
