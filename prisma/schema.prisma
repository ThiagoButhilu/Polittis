generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SIMPLE   // Produto pronto para entrega
  CUSTOM   // Produto encomendado (kit/composição)
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String
  email    String   @unique
  password String

  // Relações
  addresses Address[]
  requests  Request[]
}

model Address {
  id       Int    @id @default(autoincrement())
  street   String
  number   String
  comp     String?
  cep      String
  state    String
  city     String
  district String

  // Relação com User
  user_id Int
  user    User @relation(fields: [user_id], references: [id])
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  price       Float
  image_url   String
  category    String
  created_at  DateTime     @default(now())
  type        ProductType  @default(SIMPLE) 
  requests    Request[]
  components  ProductComponent[]
}

model ProductComponent {
  id         Int     @id @default(autoincrement())
  name       String   // Ex: "Recheio de chocolate", "12 cupcakes"
  quantity   Int?
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
}

model Request {
  id         Int      @id @default(autoincrement())
  quantity   Int
  price      Float
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relações
  user_id    Int
  product_id Int

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}
